# TABSIRA environment. Copy to .env (never commit .env). Every key of the API's
# typed settings (apps/api/src/config.py) is listed here with its development
# default; secrets are left empty. A key added to the settings is added here in
# the same commit. The API refuses to start on a missing or invalid key and
# names it. Other apps and scripts add their own sections below.

# ==== API (apps/api) ====

# development | test | production. Production refuses .test URLs and an empty AI key.
ENVIRONMENT=development
# Address the API binds to. Always loopback; nginx is the public face.
API_HOST=127.0.0.1
# Port the API listens on.
API_PORT=8000
# Public address of the web app. The .test defaults are development-only: plain HTTP on
# port 80 (decision 49); production requires https.
SITE_URL=http://tabsira.test
# Public address of this API.
API_URL=http://api.tabsira.test
# Address of the admin area (reachable through the VPN only). /admin answers this host and no
# other, and accepts state changes from this origin alone. A production start refuses .test.
ADMIN_URL=http://admin.tabsira.test
# Browser origins allowed to call the API, comma separated, no path.
CORS_ORIGINS=http://tabsira.test

# Secret. Async URL of the application database, host 127.0.0.1 (never localhost). Written by scripts/setup-db.sh.
DATABASE_URL=
# Secret. The same database over the psycopg driver, for tools that are not async. Written by scripts/setup-db.sh.
SYNC_DATABASE_URL=
# Secret. Async URL of the database tests run against; its name must end in _test. Written by scripts/setup-db.sh.
TEST_DATABASE_URL=
# Seconds to wait for a database connection before failing; short so a database that is down never hangs a page.
DB_CONNECT_TIMEOUT=3.0
# Connections kept open per API process.
DB_POOL_SIZE=5
# Extra connections a process may open under load.
DB_MAX_OVERFLOW=5

# Accounts and sessions. The session cookie is httpOnly and SameSite=Lax, and Secure wherever SITE_URL is https.
# Name of the session cookie. The __Secure- prefix makes browsers accept it over HTTPS only;
# while SITE_URL is http (local development) the API drops the prefix and the Secure flag.
SESSION_COOKIE_NAME=__Secure-tabsira_session
# Domain of the session cookie, shared by the web and api subdomains: .tabsira.test in development, .tabsira.me in production (a .test domain is refused there).
SESSION_COOKIE_DOMAIN=.tabsira.test
# Days a session stays valid after sign-in.
SESSION_TTL_DAYS=30
# Secret. Key of the keyed hashes of IP and e-mail addresses kept for rate limiting; 32 or more random characters, required in production. Empty elsewhere derives one from DATABASE_URL.
HASH_SECRET=
# bcrypt work factor of password hashes; production refuses less than 12.
PASSWORD_BCRYPT_ROUNDS=12
# Seconds over which sign-in and sign-up attempts are counted.
AUTH_ATTEMPT_WINDOW_SECONDS=900
# Attempts allowed per IP hash in that window: failed sign-ins and every sign-up.
AUTH_MAX_ATTEMPTS_PER_IP=20
# Attempts allowed per e-mail hash in that window.
AUTH_MAX_ATTEMPTS_PER_EMAIL=5

# Google sign-in (OpenID Connect with PKCE). An empty client id turns it off: its routes answer 503.
GOOGLE_CLIENT_ID=
# Secret. Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Where Google sends the browser back: this API's /auth/google/callback. Register the same address in the Google
# console; Google accepts https addresses only, so Google sign-in is not exercised on the plain-http local host.
GOOGLE_REDIRECT_URI=http://api.tabsira.test/auth/google/callback
# Seconds a started Google sign-in stays valid.
GOOGLE_STATE_TTL_SECONDS=600

# Transactional mail (verification, password reset), sent by the API itself over SMTP. While SMTP_HOST is empty nothing is sent: the endpoints answer as usual and the API logs an error.
# SMTP server host.
SMTP_HOST=
# SMTP port: 587 or 25 with starttls, 465 with ssl.
SMTP_PORT=587
# SMTP login; empty for a server that needs none.
SMTP_USERNAME=
# Secret. SMTP password.
SMTP_PASSWORD=
# starttls | ssl. Mail is never sent in clear text.
SMTP_SECURITY=starttls
# Path of a CA certificate file, only for a server that a private certificate authority signed.
SMTP_CA_FILE=
# Seconds to wait for the SMTP server.
SMTP_TIMEOUT_SECONDS=15.0
# Sender of every mail. Its domain must be verified on the mail server (SPF, DKIM, DMARC). Quoted: the file is also read by shell scripts.
MAIL_FROM="تبصرة <no-reply@tabsira.me>"
# Reply-To address; empty adds no Reply-To header.
MAIL_REPLY_TO=
# Base address of the links in mail (/verify-email, /reset-password); empty uses SITE_URL.
WEB_BASE_URL=
# Hours an e-mail verification link stays valid.
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# Minutes a password reset link stays valid.
PASSWORD_RESET_EXPIRE_MINUTES=60
# Address that receives the support form, and is named on the terms page.
SUPPORT_EMAIL=support@tabsira.me
# Address named on the privacy page for questions and requests about personal data.
PRIVACY_EMAIL=privacy@tabsira.me
# Version of the terms of use. Changing it asks every account to accept again at its next sign-in.
TERMS_VERSION=2026-10-05T18:00Z
# Version of the privacy policy. Changing it asks every account to accept again at its next sign-in.
PRIVACY_VERSION=2026-10-05T18:00Z
# Support messages allowed per client IP per hour (IPv6 grouped by /48), counted in PostgreSQL as keyed hashes.
SUPPORT_MAX_PER_IP_PER_HOUR=5
# Support messages allowed per reply-to address (keyed hash) per hour.
SUPPORT_MAX_PER_ADDRESS_PER_HOUR=3
# Support messages allowed per hour over everyone, as a ceiling.
SUPPORT_MAX_PER_HOUR=200
# Cloudflare Turnstile site key (decision 56; public, read by the web server at request time and shown to the browser, never baked into a build); with the secret below it protects sign-up, sign-in, the mail forms and support. Both empty turns the check off.
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key, used only by the API to verify tokens; set together with the site key.
TURNSTILE_SECRET_KEY=
# Language of every text the API produces; one of SUPPORTED_LANGUAGES.
DEFAULT_LANGUAGE=ar
# Languages the API has texts for, comma separated. Arabic only for now.
SUPPORTED_LANGUAGES=ar

# Feature switches (decision 63). Two comma-separated lists; a name that is not listed below
# stops the start. Every feature is on unless it is named in DISABLED_FEATURES, except the two
# marked "off by default", which are on only when named in ENABLED_FEATURES (which wins over
# DISABLED_FEATURES). A feature that is off answers 404 and must never break the core journey.
# A child is off while its parent is off: social_comments needs social, atlas_sponsorship needs
# atlas, camera_anchor needs camera_discovery, dev_inspector needs admin.
#   chat               the chat with an insight
#   world              the personal world, completion and the public insight pages
#   treasure           the hidden treasure
#   social             the social network (تبصرة تواصل)
#   social_comments    comments under posts; off by default
#   atlas              the world atlas (أطلس بصائر العالم)
#   atlas_sponsorship  «كفالة بصيرة», sponsoring an orphaned atlas entry
#   camera_discovery   camera discovery, levels A (places) and B (direction)
#   camera_anchor      camera level C (anchoring), until it is proven on devices; off by default
#   photo_storage      storing consented photos
#   canonical_verify   verifying a source against the canonical edition
#   admin              the admin area at /admin
#   dev_inspector      the developer panel (scan inspector) in the admin area
# The old FEATURE_* keys are refused at start: FEATURE_SOCIAL=false becomes "social" in
# DISABLED_FEATURES.
# The features to switch off, comma separated.
DISABLED_FEATURES=
# The features to switch on, comma separated; the way to turn on the off-by-default ones.
ENABLED_FEATURES=

# Admin area (/admin). Required in production while the admin feature is on; elsewhere empty derives a key from HASH_SECRET.
# Secret. Fernet key(s) that encrypt the admin second-factor secrets at rest, comma separated: the first encrypts, all decrypt. Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_TOTP_ENCRYPTION_KEY=
# true makes an admin who has not enrolled the second factor reach only the page that enrols it.
ADMIN_REQUIRE_TWO_FACTOR=false
# Days the admin audit log is kept; older chunks are dropped by TimescaleDB. 30 to 3650.
ADMIN_AUDIT_RETENTION_DAYS=400
# Days after which the audit log's chunks are compressed; under the retention.
ADMIN_AUDIT_COMPRESS_AFTER_DAYS=30

# Side, in metres, of the grid cell a public location is rounded to, from 100 to 50000. The exact point never leaves the server.
GEO_APPROX_CELL_METERS=1000
# Days an atlas entry may go without a sign of life (publishing, its author's edit, a sponsorship or the sponsor's reflection; views do not count) before the daily job offers it for sponsoring, 1 to 3650.
ORPHAN_AFTER_DAYS=30

# Error tracking with GlitchTip (Sentry protocol). Empty means off: nothing is sent and no SDK is started.
# Secret. DSN of the GlitchTip project of the API, https://key@host/project-id.
GLITCHTIP_DSN=
# Secret. DSN of the project that receives the browser's errors, which the web app posts to this API's /client-errors. Empty uses GLITCHTIP_DSN.
GLITCHTIP_WEB_DSN=
# Share, from 0 to 1, of requests timed as well as errors. 0 reports errors only.
GLITCHTIP_TRACES_SAMPLE_RATE=0.0
# Version part of the release name (tabsira-api@<version>), for a checkout the version cannot be read from. Empty reads the checkout, else the package version.
GLITCHTIP_RELEASE=

# Cookie consent (decision 32). Version of the current cookie policy text; change it when the text changes, and every visitor is asked again.
COOKIE_POLICY_VERSION=2026-10-04
# Days a cookie-consent choice stays in force before the visitor is asked again (182 is six months).
CONSENT_REASK_DAYS=182

# Most URLs on one page of the sitemap, from 1 to 50000 (the protocol's limit).
SITEMAP_PAGE_SIZE=10000

# Where consented photos are kept: auto (S3 when S3_BUCKET is set, the local disk otherwise) | local | s3. Production requires s3 and refuses to start without a usable bucket. A bucket needs every S3 key below, and S3 keys without a bucket are refused under auto.
STORAGE_BACKEND=auto
# Root of the local photo store, for development and test only; empty is data/media of the checkout.
LOCAL_MEDIA_DIR=
# Address of an S3-compatible service; empty uses AWS.
S3_ENDPOINT_URL=
# Region of the bucket.
S3_REGION=us-east-1
# Name of the private bucket.
S3_BUCKET=
# Access key id of the bucket's user.
S3_ACCESS_KEY_ID=
# Secret. Secret access key of the bucket's user.
S3_SECRET_ACCESS_KEY=
# Address the public/ prefix of the bucket is served from (a CDN or the bucket's public address). Only photos their owner published are ever under it.
S3_PUBLIC_BASE_URL=
# Seconds a signed link to a private photo stays valid, from 30 to 3600.
SIGNED_URL_TTL_SECONDS=300

# Which AI provider serves every stage: ovh | openai. openai by measurement: see docs/BENCHMARK.md.
AI_PROVIDER=openai

# OVHcloud AI Endpoints (OpenAI-compatible): base URL.
AI_OVH__BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# Secret. OVHcloud AI Endpoints API key.
AI_OVH__API_KEY=
# OVH model for scene description (vision), chosen by docs/BENCHMARK.md.
AI_OVH__VISION_MODEL=Qwen3.8-27B
# OVH model for the insight planner.
AI_OVH__PLANNER_MODEL=Qwen3.8-27B
# OVH model for reranking candidate evidence (RERANKER=llm); empty: none measured, the fused order is kept.
AI_OVH__RERANK_MODEL=
# OVH model for the evidence verifier.
AI_OVH__VERIFY_MODEL=Qwen3.8-27B
# OVH model for composing the explanation.
AI_OVH__COMPOSE_MODEL=Qwen3.8-27B
# OVH model for the chat: the provider's insight-stage model (decision 46).
AI_OVH__CHAT_MODEL=Qwen3.8-27B
# OVH model for embeddings, chosen by docs/BENCHMARK.md (retrieval).
AI_OVH__EMBEDDING_MODEL=bge-m3
# Vector size asked of the OVH embedding model (1 to 2000); empty keeps the model's own size.
AI_OVH__EMBEDDING_DIMENSIONS=
# OVH model for the content guard.
AI_OVH__GUARD_MODEL=
# OVH reasoning_effort sent with each request: none | minimal | low | medium | high | xhigh; empty leaves the provider default. none is measured on the vision stage only (docs/BENCHMARK.md).
AI_OVH__REASONING_EFFORT=none
# How OVH vision models write box corners: pixels (of the image sent) | thousandths (0-1000 grid). See docs/BENCHMARK.md.
AI_OVH__BOX_COORDINATES=thousandths
# OVH prices in USD per million tokens, JSON keyed by model id (input, output, optional cached_input), single-quoted so the scripts that source this file with bash keep its double quotes.
AI_OVH__PRICES='{"Qwen3.8-27B":{"input":0.47,"output":3.19},"Qwen3.6-27B":{"input":0.47,"output":3.19},"Qwen3.5-397B-A17B":{"input":0.71,"output":4.25},"Qwen3.5-9B":{"input":0.12,"output":0.18},"Qwen2.5-VL-72B-Instruct":{"input":1.01,"output":1.01},"bge-m3":{"input":0.01},"Qwen3-Embedding-8B":{"input":0.12},"Qwen3Guard-Gen-8B":{"input":0},"Qwen3Guard-Gen-0.6B":{"input":0}}'

# OpenAI: base URL.
AI_OPENAI__BASE_URL=https://api.openai.com/v1
# Secret. OpenAI API key.
AI_OPENAI__API_KEY=
# OpenAI model for scene description (vision), chosen by docs/BENCHMARK.md.
AI_OPENAI__VISION_MODEL=gpt-5.4-mini-2026-03-17
# OpenAI model for the insight planner.
AI_OPENAI__PLANNER_MODEL=gpt-5.4-mini-2026-03-17
# OpenAI model for reranking candidate evidence (RERANKER=llm), chosen by docs/BENCHMARK.md (retrieval).
AI_OPENAI__RERANK_MODEL=gpt-5.4-nano-2026-03-17
# OpenAI model for the evidence verifier.
AI_OPENAI__VERIFY_MODEL=gpt-5.4-mini-2026-03-17
# OpenAI model for composing the explanation.
AI_OPENAI__COMPOSE_MODEL=gpt-5.4-mini-2026-03-17
# OpenAI model for the chat: gpt-5.4-mini, the insight stages' model (decision 46).
AI_OPENAI__CHAT_MODEL=gpt-5.4-mini-2026-03-17
# OpenAI model for embeddings, chosen by docs/BENCHMARK.md (retrieval).
AI_OPENAI__EMBEDDING_MODEL=text-embedding-3-large
# Vector size asked of the OpenAI embedding model (1 to 2000); empty keeps the model's own size.
AI_OPENAI__EMBEDDING_DIMENSIONS=1536
# OpenAI model for the content guard: image moderation of a scan (docs/BENCHMARK.md).
AI_OPENAI__GUARD_MODEL=omni-moderation-latest
# OpenAI reasoning_effort sent with each request: none | minimal | low | medium | high | xhigh; empty leaves the provider default. none is measured on the vision stage only (docs/BENCHMARK.md).
AI_OPENAI__REASONING_EFFORT=none
# How OpenAI vision models write box corners: pixels (of the image sent) | thousandths (0-1000 grid). See docs/BENCHMARK.md.
AI_OPENAI__BOX_COORDINATES=pixels
# OpenAI prices in USD per million tokens, JSON keyed by model id (input, output, optional cached_input), single-quoted so the scripts that source this file with bash keep its double quotes.
AI_OPENAI__PRICES='{"gpt-5.4-mini-2026-03-17":{"input":0.75,"output":4.5,"cached_input":0.075},"gpt-5.4-nano-2026-03-17":{"input":0.2,"output":1.25,"cached_input":0.02},"text-embedding-3-small":{"input":0.02},"text-embedding-3-large":{"input":0.13},"omni-moderation-latest":{"input":0}}'

# Seconds one model request may take before it is abandoned (and retried).
AI_TIMEOUT_SECONDS=90.0
# Further attempts after a timeout, network error, 429, 5xx or an answer that does not match its schema (0-5).
AI_MAX_RETRIES=2
# Seconds to wait before the first retry; doubled for each later one.
AI_RETRY_BACKOFF_SECONDS=1.0

# The scripture vectors to import instead of computing (docs/EMBEDDINGS.md, task 05.4):
# a local tabsira-vectors-<date>.tar.gz or its extracted folder; empty: use the URL below.
VECTORS_ARCHIVE=
# The archive in the owners' bucket, downloaded once into ../tabsira-data/vectors and checked
# against its .sha256; empty: never download (embed_corpus then computes, which costs money).
VECTORS_ARCHIVE_URL=https://s3-v2.riastorage.com/tabsira/vectors/tabsira-vectors-2026-10-04.tar.gz
# The scripture store, the world ontology and the learning path to install (docs/CORPUS.md,
# decision 57): a local tabsira-corpus-<date>.tar.gz; empty: use the URL below.
CORPUS_ARCHIVE=
# The archive in the owners' bucket, downloaded once into ../tabsira-data/corpus and checked
# against its .sha256; empty: never download (make data then builds the store from its sources).
CORPUS_ARCHIVE_URL=https://s3-v2.riastorage.com/tabsira/corpus/tabsira-corpus-2026-10-04.tar.gz
# GeoNames for the atlas, as one pg_dump of the geodata schema (scripts/geodata/ensure.sh):
# a local tabsira-geodata-<date>.dump; empty: use the URL below.
GEODATA_DUMP=
# The dump's address, downloaded once into ../tabsira-data/geodata and checked against its
# .sha256; empty (the default here): make data skips GeoNames. The owners' bucket has
# https://s3-v2.riastorage.com/tabsira/geodata/tabsira-geodata-2026-10-04.dump
GEODATA_DUMP_URL=
# Where GeoNames comes from: dump (the verified 2026-10-04 snapshot above) or geonames (a fresh
# import from geonames.org, about 600 MB and 15 minutes); --geonames-source overrides it.
GEONAMES_SOURCE=dump

# Object detector (services/vision), reached over HTTP only; when it does not answer the scan goes on without boxes.
DETECTOR_URL=http://127.0.0.1:8100
# Seconds to wait for the detector before skipping it.
DETECTOR_TIMEOUT_SECONDS=30.0
# What reranks evidence candidates (decision 41): llm (the provider's rerank model; none set means no reranking) | cross_encoder (services/vision at RERANKER_URL, for a GPU host) | off. On failure the fused order is kept.
# off by default (decision 50): the verifier judges the fused head; llm or cross_encoder to rerank first.
RERANKER=off
# Cross-encoder used when RERANKER=cross_encoder (services/vision, POST /rerank); empty switches it off.
RERANKER_URL=http://127.0.0.1:8100
# Seconds to wait for the reranker before keeping the fused order.
RERANKER_TIMEOUT_SECONDS=8.0

# Seconds the social network's automatic guard may take to judge one post or comment before it waits for a person.
SOCIAL_GUARD_TIMEOUT_SECONDS=8.0
# Moderation score (0-1) under which a post or comment is published at once; at or over it, a person decides.
SOCIAL_GUARD_ALLOW_SCORE=0.4
# Moderation score (0-1) at or over which a post or comment is refused at once; must be above the allow score.
SOCIAL_GUARD_REJECT_SCORE=0.85
# Distinct accounts that must report a published post or comment before it returns to the moderation queue (0 turns it off).
SOCIAL_REPORT_HOLD_THRESHOLD=3
# Days a moderation log row is kept before its whole chunk is dropped (30-3650).
MODERATION_LOG_RETENTION_DAYS=730
# Days after which moderation log chunks are compressed (1-365).
MODERATION_LOG_COMPRESS_AFTER_DAYS=30

# Largest photo accepted for a scan, in bytes (15 MB).
IMAGE_MAX_BYTES=15728640
# Largest decoded photo, in pixels, checked from the header before decoding.
IMAGE_MAX_PIXELS=40000000
# Seconds the server may spend fetching a photo given by its address (public addresses and default ports only).
IMAGE_URL_TIMEOUT_SECONDS=12.0
# Redirects followed when fetching a photo given by its address; each hop is checked again.
IMAGE_URL_MAX_REDIRECTS=3

# Redis (decision 21): scan progress for the reader's stream and the queue of scan jobs. Durable state stays in PostgreSQL.
# Redis URL, host 127.0.0.1 (never localhost), no password in it.
REDIS_URL=redis://127.0.0.1:6379/0
# Secret. Redis password; required in production, empty for a development Redis that has none.
REDIS_PASSWORD=
# Redis database the tests use, never the one of REDIS_URL; empty runs the tests on an in-process fake.
TEST_REDIS_URL=

# Guests. A signed, httpOnly, Secure, SameSite=Lax cookie holds a random key; the server keeps only its hash.
# Name of the guest cookie.
GUEST_COOKIE_NAME=__Secure-tabsira_guest
# Days a guest's saved insights are kept after their last visit; merged into the account at the first sign-in.
GUEST_TTL_DAYS=90

# Scans.
# Insight engine: pipeline | demo. demo is a declared simulation for development and smoke tests; production refuses it.
SCAN_ENGINE=pipeline
# Seconds a scan job may run before it is stopped and reported as failed (at most 540).
SCAN_JOB_TIMEOUT_SECONDS=240.0
# Seconds the stripped photo of a scan stays in the temporary store for its owner. A sensitive scene's photo is dropped at once.
SCAN_IMAGE_TTL_SECONDS=3600
# Seconds the progress events of a scan stay available to a reconnecting reader.
SCAN_EVENTS_TTL_SECONDS=3600
# Successful user messages allowed in the chat of one insight (v2 §14).
MAX_CHAT_USER_MESSAGES=3
# How many of the three optional profile questions the web asks after the first insight, 0 to 3 (v2 §5). Read by the API settings and inlined into the web build.
PROFILE_QUESTIONS_MAX=3
# Days after which a hidden treasure shows on return.
TREASURE_REVEAL_AFTER_DAYS=3
# Hours after which a visit to its place shows a hidden treasure.
TREASURE_RETURN_AFTER_HOURS=12

# Time series (TimescaleDB hypertables). Apply changed values with: uv run python -m src.cli.timeseries_policy
# Days of scan stage events kept.
SCAN_EVENTS_RETENTION_DAYS=90
# Days before scan stage events are compressed.
SCAN_EVENTS_COMPRESS_AFTER_DAYS=7
# Days of AI call records kept.
AI_CALLS_RETENTION_DAYS=400
# Days before AI call records are compressed.
AI_CALLS_COMPRESS_AFTER_DAYS=30
# Days of evidence exposures (what a learner completed and was shown) kept.
EVIDENCE_EXPOSURES_RETENTION_DAYS=730
# Days before evidence exposures are compressed.
EVIDENCE_EXPOSURES_COMPRESS_AFTER_DAYS=30

# ==== Web (apps/web) ====
# Public site address baked into the web build; empty means SITE_URL above. A production build refuses a .test address.
NEXT_PUBLIC_SITE_URL=
# Public API address baked into the web build; empty means API_URL above. A production build refuses a .test address.
NEXT_PUBLIC_API_URL=
# Google Analytics 4 measurement id (G-XXXXXXXX), read from the web server's environment at request time, never baked into a build; empty means no analytics code at all.
GA_MEASUREMENT_ID=
# Microsoft Clarity project id (heatmaps), read from the web server's environment at request time, never baked into a build; loaded only after the visitor accepts the behaviour category; empty means no heatmaps.
CLARITY_PROJECT_ID=
# Where the web server itself reaches the API (the consent check of the first paint, the cookie form without JavaScript), read from its environment; empty means http://127.0.0.1:8000 outside production and the public API address in production.
API_INTERNAL_URL=
