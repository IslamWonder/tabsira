# Apply the daily Quran text corrections. One process, started by tabsira-sync-quran.timer, never by a worker.
# Installed by deploy/apply-config.sh.
[Unit]
Description=TABSIRA: Apply the daily Quran text corrections
After=network-online.target

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_ROOT@/current/apps/api
Environment=UV_PYTHON_PREFERENCE=only-managed
Environment=ENV_FILE=@ENV_FILE@
ExecStart=@APP_HOME@/.local/bin/uv run --no-sync python -m src.cli.sync_quran
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
