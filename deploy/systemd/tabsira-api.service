# TABSIRA API: gunicorn with uvicorn workers. Installed by deploy/apply-config.sh,
# which fills @APP_USER@, @APP_GROUP@, @REPO_DIR@ and @ENV_FILE@.
#
# It runs from the clone, in place, as on the earlier prototype: a deploy resets
# the clone, then workers forked after it (deploy/api-roll.sh, TTIN then TTOU)
# import the new code.
# The pid file is how that script finds the master. Settings of the application
# are read by the application itself from @ENV_FILE@ (the clone's .env), in each worker.
[Unit]
Description=TABSIRA API (gunicorn, uvicorn workers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@REPO_DIR@/apps/api
Environment=ENV_FILE=@ENV_FILE@
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=tabsira-api
RuntimeDirectoryPreserve=yes
ExecStart=@REPO_DIR@/apps/api/.venv/bin/python -m gunicorn src.main:app -c @REPO_DIR@/deploy/gunicorn.conf.py --chdir @REPO_DIR@/apps/api --pid /run/tabsira-api/gunicorn.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
