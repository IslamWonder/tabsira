# Re-apply the admin audit retention policy. One process, started by tabsira-audit-retention.timer, never by a worker.
# Installed by deploy/apply-config.sh.
[Unit]
Description=TABSIRA: Re-apply the admin audit retention policy
After=network-online.target

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@REPO_DIR@/apps/api
Environment=UV_PYTHON_PREFERENCE=only-managed
Environment=ENV_FILE=@ENV_FILE@
ExecStart=@APP_HOME@/.local/bin/uv run --no-sync python -m src.cli.audit_policy
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
