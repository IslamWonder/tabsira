# TABSIRA scan worker: the one process that runs scan jobs from the Redis queue
# (apps/api, src.cli.scan_worker). Installed by deploy/apply-config.sh, which
# fills @APP_USER@, @APP_GROUP@, @REPO_DIR@ and @ENV_FILE@.
#
# Exactly one instance, never one per API worker (AGENTS.md). It runs from the clone
# like the API, so a restart after a deploy imports the new code.
# SIGTERM makes it stop taking jobs and let the running ones finish for up to
# SCAN_JOB_TIMEOUT_SECONDS (240 s by default); TimeoutStopSec covers that plus a
# margin, so systemd does not SIGKILL a scan that is about to finish. If you raise
# SCAN_JOB_TIMEOUT_SECONDS, raise TimeoutStopSec above it. A job cut short stays
# unacknowledged on the queue and is delivered again; running it twice changes nothing.
[Unit]
Description=TABSIRA scan worker (Redis queue consumer)
After=network-online.target tabsira-api.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@REPO_DIR@/apps/api
Environment=ENV_FILE=@ENV_FILE@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_DIR@/apps/api/.venv/bin/python -m src.cli.scan_worker
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
