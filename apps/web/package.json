{
  "name": "@tabsira/web",
  "version": "0.1.0",
  "private": true,
  "description": "TABSIRA web app: Arabic right-to-left PWA, phone first",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "gen:api": "bash scripts/gen-api.sh",
    "gen:icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.12.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/readex-pro": "5.3.0",
    "@fontsource/reem-kufi": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
