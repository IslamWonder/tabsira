{
  "openapi": "3.1.0",
  "info": {
    "title": "TABSIRA API",
    "description": "Photo to insight, backed by one Quran verse and one hadith.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness",
        "description": "Report that the process is up and serving.\n\nTouches no dependency, so it stays cheap enough for a per-second probe and\nanswers even when the database is down.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness",
        "description": "Report whether this process can serve a request, which needs the database.\n\nThe check is bounded by the connect timeout, so a database that is down or\nhangs answers 503 `degraded` quickly instead of holding the request.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "Create an account with an e-mail address and a password",
        "description": "Create the account, sign it in, and mail a verification link.\n\nThe new account can be used at once; its address stays unverified until the\nlink is followed. Rate limited per IP and per e-mail address. A mail that\ncannot be sent never fails the sign-up.",
        "operationId": "signup_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Sign in with an e-mail address and a password",
        "description": "Start a session.\n\nA wrong address and a wrong password answer the same 401. Rate limited per IP\nand per e-mail address, counting failed attempts, before the password is checked.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "End the current session",
        "description": "End the session and clear the cookie. Safe to repeat, and to call with no session.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "The signed-in account",
        "description": "Return the caller's own account. The private profile fields are not part of it.",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/providers": {
      "get": {
        "tags": ["auth"],
        "summary": "Which ways of signing in are available",
        "description": "Whether password and Google sign-in can be used, for the sign-in page to show.",
        "operationId": "providers_auth_providers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["auth"],
        "summary": "Confirm an e-mail address with the mailed link's token",
        "description": "Mark the address verified. The token works once; any bad token answers the same 400.\n\nThe caller needs no session: whoever holds the token read the mail.",
        "operationId": "verify_email_auth_verify_email_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": ["auth"],
        "summary": "Mail the verification link again",
        "description": "Answer 202 whether or not the address has an unverified account.\n\nRate limited per IP and per address. A new link cancels the earlier one.",
        "operationId": "resend_verification_auth_resend_verification_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Mail a password reset link",
        "description": "Answer 202 whether or not the address has an account.\n\nRate limited per IP and per address. A new link cancels the earlier one. The\nmail is sent after the answer, so the time it takes says nothing either.",
        "operationId": "forgot_password_auth_forgot_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Choose a new password with the mailed link's token",
        "description": "Set the new password and end every other session of the account.\n\nThe token works once. Following it also proves the address, so it is marked\nverified. The caller is not signed in by it: they sign in with the new password.",
        "operationId": "reset_password_auth_reset_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google/start": {
      "get": {
        "tags": ["auth"],
        "summary": "Send the browser to Google to sign in",
        "description": "Begin the authorization code flow with PKCE (S256), a state and a nonce.\n\nRedirects to Google. The state, the code verifier and the nonce are kept on\nthe server for GOOGLE_STATE_TTL_SECONDS; a cookie ties them to this browser.",
        "operationId": "start_auth_google_start_get",
        "parameters": [
          {
            "name": "next",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "A path in the web app to return to; anything else is ignored.",
              "title": "Next"
            },
            "description": "A path in the web app to return to; anything else is ignored."
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": ["auth"],
        "summary": "Where Google sends the browser back",
        "description": "Finish the sign-in: check the state, exchange the code, validate the ID token.\n\nThen link or create the account, start a session and redirect to the web app.",
        "operationId": "callback_auth_google_callback_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/profile": {
      "get": {
        "tags": ["profile"],
        "summary": "The caller's profile",
        "description": "Return the caller's own profile, empty answers as `unknown`.\n\nThe religious background, the gender and the age range are private: this\nroute and the account export are the only places they are ever returned.",
        "operationId": "get_profile_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["profile"],
        "summary": "Change some answers of the caller's profile",
        "description": "Change the fields sent and no others.\n\nEnums are validated; a null is refused (send `unknown` to clear an answer).\nThe three consent switches change through `POST /consents` only.",
        "operationId": "patch_profile_profile_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/consents": {
      "post": {
        "tags": ["profile"],
        "summary": "Record an answer to a consent question",
        "description": "Append the answer to the user's consent history, and update the matching switch.\n\nA consent is withdrawn by recording the same kind with `granted` false. The\nhistory is never edited.",
        "operationId": "post_consent_consents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentOut"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/account/export": {
      "get": {
        "tags": ["account"],
        "summary": "Download everything the account owns",
        "description": "Return the account, its profile, consents, linked identities and sessions as JSON.",
        "operationId": "export_account_account_export_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountExport"
                }
              }
            }
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/account": {
      "delete": {
        "tags": ["account"],
        "summary": "Delete the account and everything it owns",
        "description": "Delete the user, their profile, consents, linked identities and every session.\n\nIdempotent: without a valid session there is nothing left to delete, and the\nanswer is the same 204 that clears the cookie.",
        "operationId": "delete_account_account_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "description": "An error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountExport": {
        "properties": {
          "exported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Exported At"
          },
          "user": {
            "$ref": "#/components/schemas/UserExport"
          },
          "oauth_accounts": {
            "items": {
              "$ref": "#/components/schemas/OAuthAccountExport"
            },
            "type": "array",
            "title": "Oauth Accounts"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionExport"
            },
            "type": "array",
            "title": "Sessions"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileOut"
          },
          "consents": {
            "items": {
              "$ref": "#/components/schemas/ConsentOut"
            },
            "type": "array",
            "title": "Consents"
          }
        },
        "type": "object",
        "required": ["exported_at", "user", "oauth_accounts", "sessions", "profile", "consents"],
        "title": "AccountExport",
        "description": "Everything the account owns so far, for its owner.\n\nA table that gets a user id later must be added here and to the deletion in\n`account_service`; a test fails when a table references `users` without a cascade."
      },
      "AgeRange": {
        "type": "string",
        "enum": ["under_13", "13_17", "18_24", "25_39", "40_59", "60_plus", "unknown"],
        "title": "AgeRange"
      },
      "ConsentIn": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ConsentKind"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,32}$",
            "title": "Version"
          },
          "granted": {
            "type": "boolean",
            "title": "Granted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "version", "granted"],
        "title": "ConsentIn"
      },
      "ConsentKind": {
        "type": "string",
        "enum": ["terms", "photo_storage", "personalization", "memory"],
        "title": "ConsentKind"
      },
      "ConsentOut": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ConsentKind"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "granted": {
            "type": "boolean",
            "title": "Granted"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": ["kind", "version", "granted", "created_at"],
        "title": "ConsentOut"
      },
      "EmailIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["email"],
        "title": "EmailIn",
        "description": "An address, for the routes that mail a link to it."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "VALIDATION_ERROR",
          "RATE_LIMITED",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE",
          "HTTP_ERROR",
          "INVALID_CREDENTIALS",
          "EMAIL_TAKEN",
          "ACCOUNT_DISABLED",
          "EMAIL_NOT_VERIFIED",
          "INVALID_TOKEN",
          "ORIGIN_NOT_ALLOWED",
          "CONSENT_NOT_ALLOWED",
          "GOOGLE_NOT_CONFIGURED"
        ],
        "title": "ErrorCode",
        "description": "The stable error codes. A code is never renamed or reused."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          }
        },
        "type": "object",
        "required": ["error", "detail"],
        "title": "ErrorResponse",
        "description": "The body of every error response."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": ["loc", "message", "type"],
        "title": "FieldError",
        "description": "One rejected field of a request: where it is and why it was refused."
      },
      "Gender": {
        "type": "string",
        "enum": ["man", "woman", "unknown"],
        "title": "Gender"
      },
      "Goal": {
        "type": "string",
        "enum": [
          "discover_islam",
          "reflection",
          "learn_quran_sunnah",
          "live_values",
          "research",
          "teaching",
          "curiosity"
        ],
        "title": "Goal",
        "description": "Why the user is here (master prompt v2, section 5); several may be chosen."
      },
      "KnowledgeLevel": {
        "type": "string",
        "enum": ["new", "general", "advanced", "specialist", "unknown"],
        "title": "KnowledgeLevel"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "Liveness"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["email", "password"],
        "title": "LoginIn"
      },
      "OAuthAccountExport": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "created_at": {
