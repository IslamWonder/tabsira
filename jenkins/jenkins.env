# Defaults of the continuous integration pipeline. No secret lives here.
#
# Read by the Jenkinsfile (readProperties) and by every script in jenkins/
# (jenkins/ci-env.sh). Plain KEY=VALUE lines: no quotes, no spaces around the
# equals sign, no shell syntax. A blank value means "not set".
#
# Precedence, highest first:
#   1. the build parameter of the same name, when it is not blank
#   2. a variable of the same name defined on the Jenkins job or in
#      Manage Jenkins > System > Global properties > Environment variables
#   3. this file
# docs/JENKINS_SETUP.md lists every key with the place it comes from.

# ==== SonarQube ====

# Address of the SonarQube server, for example https://sonar.example.org. Blank
# skips the SonarQube stage with a warning; asking for it with RUN_SONAR when
# this is blank fails the stage.
SONAR_HOST_URL=
# Project key and display name on the server.
SONAR_PROJECT_KEY=tabsira
SONAR_PROJECT_NAME=TABSIRA
# Id of the Jenkins "Secret text" credential that holds the analysis token.
SONAR_CREDENTIALS_ID=SONAR_TOKEN
# The only branch analysed automatically. The Community Build keeps a single
# branch, so analysing another one replaces what the server shows.
SONAR_BRANCH=main
# Seconds to wait for the quality gate.
SONAR_QUALITYGATE_TIMEOUT=600

# ==== Jenkins ====

# Name of the NodeJS tool (Manage Jenkins > Tools) that provides Node 24.
NODE_TOOL_NAME=node-24-lts
# Minutes before a whole build is aborted.
CI_TIMEOUT_MINUTES=60

# ==== Notifications (Zulip plugin; its server and bot are set once in Jenkins) ====

# Stream and topic to post the result to. Either one blank sends nothing.
ZULIP_STREAM=
ZULIP_TOPIC=

# ==== Per-build services ====
# Every build starts its own PostgreSQL and its own Redis (jenkins/ci-services.sh).

# Image of the database. It must bundle PostgreSQL 18, PostGIS, pgvector and the
# TimescaleDB Community build.
CI_PG_IMAGE=timescale/timescaledb-ha:pg18.6-ts2.30.2
# Image of Redis: the job queue, scan-progress pub/sub, caches and rate-limit
# counters (decision 21).
CI_REDIS_IMAGE=redis:8.10.2-alpine
# Seconds to wait for each of them to accept connections (a cold agent pulls the image first).
CI_WAIT_SECONDS=300
# Containers older than this are taken for leftovers of a killed build and removed.
CI_SWEEP_MAX_AGE=4h
# Parallel pytest workers, each on its own database copied from a template. 0 runs serially.
CI_PYTEST_WORKERS=0
