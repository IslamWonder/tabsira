{
  "threshold": 3,
  "reporters": ["console", "consoleFull"],
  "format": ["python", "typescript", "javascript", "tsx", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/htmlcov/**",
    "**/__pycache__/**",
    "**/*.min.js",
    "**/*.bundle.js",
    "**/*.config.*",
    "**/alembic/versions/**",
    "**/alembic_geodata/versions/**",
    "**/alembic_vectors/versions/**",
    "**/tests/**",
    "**/public/**",
    "data/**",
    "services/vision/weights/**",
    "docs/**",
    "scripts/**",
    "apps/web/src/lib/api/schema.d.ts"
  ],
  "absolute": false,
  "gitignore": true
}
